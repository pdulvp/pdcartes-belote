{
    // Everything there is to do with this project, in the Run and Debug list
    // so that it is one dropdown and F5 rather than two menus.
    //
    // The first starts the game under gdb. The rest are commands run in a
    // terminal: "node-terminal" is the way VS Code's own launcher runs one,
    // and nothing about them is JavaScript -- it is the shell.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pdcartes-belote",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pdcartes-belote",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Print containers and strings as what they hold",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        },
        {
            "name": "Build",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -S . -B build && cmake --build build --parallel"
        },
        {
            "name": "Package (.deb)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -S . -B build && cmake --build build --target deb && ls -la build/*.deb"
        }
    ]
}
