{
    // Tout ce qu'il y a à faire sur ce projet, dans la liste « Exécuter et
    // déboguer » : une liste déroulante et F5, plutôt que deux menus.
    //
    // La première entrée lance le jeu sous gdb. Les autres sont des commandes
    // passées dans un terminal : « node-terminal » est la façon dont le
    // lanceur de VS Code en ouvre un, et rien là-dedans n'est du JavaScript
    // -- c'est le shell.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "pdcartes-belote",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pdcartes-belote",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Afficher conteneurs et chaînes par ce qu'ils contiennent",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        },
        {
            "name": "Build",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -S . -B build && cmake --build build --parallel"
        },
        {
            "name": "Package (.deb)",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "command": "cmake -S . -B build && cmake --build build --target deb && ls -la build/*.deb"
        }
    ]
}
