{
    // Ce qu'il y a à faire sur ce projet depuis l'éditeur. Chaque entrée est
    // la commande même qu'on taperait dans un terminal : rien ici ne sait
    // quoi que ce soit que le build ignore.
    "version": "2.0.0",
    "tasks": [
        {
            // Écrit les fichiers de build. Rarement utile à la main : un
            // build la relance de lui-même dès que CMakeLists.txt ou VERSION
            // change.
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", "${workspaceFolder}", "-B", "${workspaceFolder}/build"],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--parallel"],
            "dependsOn": ["Configure"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "Compile, et tamponne le binaire de l'instant où il a été fait"
        },
        {
            "label": "Package (.deb)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build", "--target", "deb"],
            "dependsOn": ["Configure"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "detail": "Construit, puis empaquette build/pdcartes-belote_<version>~<empreinte>_<arch>.deb"
        }
    ]
}
